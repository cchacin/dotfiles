export ANTIDOTE_HOME="${HOME}/.config/antidote/cache"

# Set the root name of the plugins files (.txt and .zsh) antidote will use.
ZSH_PLUGINS="${HOME}/.zsh_plugins"

# Discover antidote location (Homebrew or fallback clone)
if command -v brew >/dev/null 2>&1 && [ -f "$(brew --prefix)/opt/antidote/share/antidote/antidote.zsh" ]; then
  source "$(brew --prefix)/opt/antidote/share/antidote/antidote.zsh"
  fpath=("$(brew --prefix)/opt/antidote/share/antidote/functions" $fpath)
elif [ -f "${HOME}/.antidote/antidote.zsh" ]; then
  source "${HOME}/.antidote/antidote.zsh"
  fpath=("${HOME}/.antidote/functions" $fpath)
fi

autoload -Uz antidote

# Ensure the .zsh_plugins.txt file exists
[[ -f "${ZSH_PLUGINS}.txt" ]] || touch "${ZSH_PLUGINS}.txt"

# Generate a new static file whenever .zsh_plugins.txt is updated.
if [[ ! "${ZSH_PLUGINS}.zsh" -nt "${ZSH_PLUGINS}.txt" ]]; then
  antidote bundle <"${ZSH_PLUGINS}.txt" >|"${ZSH_PLUGINS}.zsh"
fi

# Source your static plugins file.
if [[ -f "${ZSH_PLUGINS}.zsh" ]]; then
  source "${ZSH_PLUGINS}.zsh"
fi
