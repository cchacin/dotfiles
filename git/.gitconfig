[filter "media"]
	required = true
	clean = git media clean %f
	smudge = git media smudge %f
[core]
	fileMode = false
	ignorecase = false
	commitGraph = true
	autocrlf = input
	excludesfile = ~/.gitignore
	pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
[user]
	name = Carlos Chacin
	email = cchacin@gmail.com
	useconfigonly = true
	signingkey = 2DBE2879
[include]
	path = ~/.gitconfig.local
[includeIf "gitdir:~/workplace/"]
  path = .gitconfig-work
[merge]
	tool = diffmerge
[diff]
	tool = hunk
  	algorithm = histogram
   	colorMoved = default
    mnemonicPrefix = true
[filter "hawser"]
	clean = git hawser clean %f
	smudge = git hawser smudge %f
	required = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[commit]
	gpgsign = false
[gpg]
	program = /usr/local/bin/gpg
[color]
	ui = true
[rerere]
	enabled = true
[pull]
	rebase = true
[gc]
	writeCommitGraph = true
[help]
	format = man
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = !/opt/homebrew/bin/gh auth git-credential
[column]
	ui = auto
[branch]
	sort = -committerdate
[difftool "hunk"]
	cmd = hunk difftool \"$LOCAL\" \"$REMOTE\" \"$MERGED\"
[difftool]
	prompt = false
[alias]
	hdiff = -c core.pager=\"hunk pager\" diff
	hshow = -c core.pager=\"hunk pager\" show
